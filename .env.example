APP_NAME=Autonomous Media Engine
DATABASE_PATH=./data/content.db
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
CONTENT_LANGUAGE=english
VIDEO_MIN_SECONDS=30
VIDEO_MAX_SECONDS=45
MAX_TOPICS_PER_RUN=40
REQUEST_TIMEOUT_SECONDS=180
# Vertical export: Full HD (1080 x 1920), 30 fps
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CODEC=libx264
VIDEO_CRF=20
VIDEO_PRESET=medium
VIDEO_AUDIO_BITRATE=192k
FFMPEG_BIN=ffmpeg

VIDEO_OUTPUT_DIR=./output

# Fully local Piper neural English voice (no API key or internet after model download)
PIPER_MODEL_PATH=./models/voices/en_US-ryan-high.onnx
PIPER_LENGTH_SCALE=1.16
PIPER_NOISE_SCALE=0.72
PIPER_NOISE_W_SCALE=0.78


# Optional: free Pexels API key for real stock-video clips (get one at https://www.pexels.com/api/)
PEXELS_API_KEY=

# Alternative stock-video provider if Pexels key issuance is unavailable
PIXABAY_API_KEY=


# Reject weak Pixabay keyword matches (0-1 heuristic score)
MIN_VISUAL_RELEVANCE=0.38
