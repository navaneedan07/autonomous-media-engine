APP_NAME=Autonomous Media Engine
DATABASE_PATH=./data/content.db
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
CONTENT_LANGUAGE=english
VIDEO_MIN_SECONDS=30
VIDEO_MAX_SECONDS=45
MAX_TOPICS_PER_RUN=40
REQUEST_TIMEOUT_SECONDS=180
# Vertical export: Full HD (1080 x 1920), 30 fps
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CODEC=libx264
VIDEO_CRF=20
VIDEO_PRESET=medium
VIDEO_AUDIO_BITRATE=192k
FFMPEG_BIN=ffmpeg

VIDEO_OUTPUT_DIR=./output

# Expressive neural English voice (requires internet; no API key)
AME_TTS_VOICE=en-US-ChristopherNeural
AME_TTS_RATE=+8%
AME_TTS_PITCH=+2Hz
AME_TTS_VOLUME=+0%

# Optional: free Pexels API key for real stock-video clips (get one at https://www.pexels.com/api/)
PEXELS_API_KEY=

# Alternative stock-video provider if Pexels key issuance is unavailable
PIXABAY_API_KEY=

# ElevenLabs (recommended). Keep the API key in your local .env only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.38
ELEVENLABS_SIMILARITY=0.78
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEED=1.06
